from query_engine.safety_response_layer import (
    SafetyResponseLayer,
)


def test_clean_response():

    layer = SafetyResponseLayer()

    result = layer.validate(
        "Hypertension is persistently elevated blood pressure.",
        urgent=False,
    )

    assert result.safe is True
    assert result.modified is False
    assert result.violations == []


def test_diagnostic_certainty():

    layer = SafetyResponseLayer()

    result = layer.validate(
        "You definitely have a heart attack.",
        urgent=False,
    )

    assert result.safe is False
    assert "diagnostic_certainty" in result.violations


